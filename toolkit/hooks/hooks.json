{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$ZCODE_PLUGIN_ROOT/scripts/session-start.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$ZCODE_PLUGIN_ROOT/scripts/pre-write-guard.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$ZCODE_PLUGIN_ROOT/scripts/pre-bash-guard.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$ZCODE_PLUGIN_ROOT/scripts/post-edit-lint-hint.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$ZCODE_PLUGIN_ROOT/scripts/stop-checkpoint-reminder.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
